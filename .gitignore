# ============================================
# 2. 大型数据文件 (严禁上传)
# ============================================
# 原始 zip 压缩包
*.zip
*.rar
*.7z
*.tar.gz

# 大型 Excel 文件 (>10MB)
*.xlsx
*.xls
!examples/*.xlsx
!samples/*.xlsx
!test-fixtures/*.xlsx

# CSV 数据文件
*.csv
!examples/*.csv
!samples/*.csv

# 日志与日志文件
*.log
*.log.*

# 二进制与模型权重
*.pt
*.pth
*.onnx
*.engine
*.h5
*.hdf5
*.pkl
*.pickle
*.bin
*.npy
*.npz

# Redis / MySQL dump
*.sql
*.dump
*.rdb
*.aof

# ============================================
