# ============================================
.env
.env.local
.env.*.local
secrets.yaml
secrets.json
credentials.json
*.pem
*.key
*.crt
config.local.*

# ============================================
# 4. 文档与渲染中间文件
# ============================================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# ============================================
# 5. 临时与备份
# ============================================
*.tmp
*.bak
*.backup
*.swp
.~*

